manifest {
    name = 'pdac-ampliconsuite-purple'
    nextflowVersion = '>=24.10.0'
    mainScript = 'main.nf'
}

params {
    mode = 'purple'
    input = null
    purple = null
    mask = null
    reference = null
    outdir = null
}

process {
    container = 'docker.io/jluebeck/ampliconsuite-pipeline@sha256:0090be065583ef8334d9c6bcd9fbf735c0984f46d65bd1de37e0b1d8db2c957c'

    withName: PREPARE_SEEDS {
        cpus = 1
        memory = 4.GB
        time = 1.h
    }

    withName: 'AMPLICON_SUITE|AMPLICON_SUITE_DEFAULT' {
        cpus = 8
        memory = { 32.GB * task.attempt }
        time = 20.h
        maxForks = 16
        errorStrategy = { task.exitStatus in [137, 143, 104] ? 'retry' : 'terminate' }
        maxRetries = 1
    }
}
